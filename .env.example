# ── POVINNÉ ──────────────────────────────────────────────────────────────────

# Telegram Bot Token — získáš od @BotFather v Telegramu (/newbot)
TELEGRAM_TOKEN=7812345678:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tvoje Telegram User ID — pošli zprávu @userinfobot a zkopíruj číslo
ALLOWED_USER_ID=123456789

# Claude API klíč — z https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Heslo od Endory (pro info@ai-masters.eu)
SMTP_PASS=tvoje_heslo_endora

# ── VOLITELNÉ ─────────────────────────────────────────────────────────────────

# OpenAI klíč — pro hlasové zprávy (Whisper). Bez něj funguje jen text.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP nastavení (výchozí hodnoty jsou správné pro Endoru)
SMTP_HOST=mail.endora.cz
SMTP_PORT=465
SMTP_USER=info@ai-masters.eu
EMAIL_FROM_NAME=Lukas Kadlecek | AI Masters

# Cesta k databázi paměti
DB_PATH=agent_memory.db
